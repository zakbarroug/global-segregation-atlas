{
  "openapi": "3.1.0",
  "info": {
    "title": "Global Segregation Atlas",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/providers": {
      "get": {
        "summary": "Providers",
        "operationId": "providers_providers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/places/search": {
      "get": {
        "summary": "Places",
        "operationId": "places_places_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analysis": {
      "post": {
        "summary": "Analysis",
        "operationId": "analysis_analysis_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "One typed Event JSON object per line; complete is terminal",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "properties": {
                    "event": {
                      "type": "string",
                      "enum": [
                        "started",
                        "geography_ready",
                        "source_found",
                        "discovery_progress",
                        "downloading",
                        "validating",
                        "metric_computed",
                        "map_ready",
                        "insufficient_data",
                        "failed",
                        "complete"
                      ],
                      "title": "Event"
                    },
                    "data": {
                      "additionalProperties": true,
                      "type": "object",
                      "title": "Data"
                    }
                  },
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "event",
                    "data"
                  ],
                  "title": "Event"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "city_id": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 10,
            "title": "City Id"
          },
          "requested_year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2030.0,
                "minimum": 2020.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Year"
          },
          "indices": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "dissimilarity",
                    "isolation",
                    "exposure",
                    "theil_h",
                    "rank_order_h"
                  ]
                },
                "type": "array",
                "maxItems": 5
              },
              {
                "type": "null"
              }
            ],
            "title": "Indices"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "city_id"
        ],
        "title": "AnalysisRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}