# Developer credentials; end users never need an account or key.
CENSUS_API_KEY=
GEONAMES_USERNAME=
# Photon public demo is rate-limited to one search/second/process. Not a production SLA.
GEOCODER=photon
APP_ENV=development
ACS_YEAR=2024
# Use the same random >=32-character secret in every API worker in production.
PLACE_TOKEN_SECRET=
API_INTERNAL_URL=http://127.0.0.1:8000
# Public browser style URL for a contracted MapLibre tile provider, e.g. MapTiler.
# Empty uses OSM raster tiles for modest interactive development only.
MAP_STYLE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HTTP_TIMEOUT_SECONDS=25
ANALYSIS_TIMEOUT_SECONDS=180
MAX_CONCURRENT_ANALYSES=2
MAX_DOWNLOAD_BYTES=25000000
MAX_REQUEST_DOWNLOAD_BYTES=120000000
MAX_RESPONSE_BYTES=16000000
MAX_AREAS=10000
# Optional bounded AI discovery. Never used for statistical calculations.
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-4.1-mini
ENABLE_AI_DISCOVERY=false
# Optional alternative: OpenAI-compatible API, including a local model or OpenRouter.
# Python performs source discovery/inspection; the model only proposes metadata mappings.
AI_PROVIDER=openai
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_ALLOW_LOCAL=false
# For OpenRouter, refuses paid model IDs, paid tools and model fallback lists.
AI_FREE_ONLY=true
# Example (operator supplies AI_API_KEY):
# AI_PROVIDER=compatible
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=xingchen-agi/xing4.0-29b-a4b:free
# Optional external search instance; must allow JSON responses on POST /search.
# Independent of the model/API key. No paid fallback. No instance bundled here.
WEB_DISCOVERY_ENABLED=false
WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=
TAVILY_API_KEY=
# Checks /usage and refuses a paid plan, pay-as-you-go, or exhausted free allowance.
TAVILY_FREE_ONLY=true
SEARCH_ALLOW_LOCAL=false
DISCOVERY_MAX_PAGES=8
DISCOVERY_MAX_SEARCHES=3
DISCOVERY_MAX_STEPS=6
DISCOVERY_TIMEOUT_SECONDS=90
MAX_TABLE_ROWS=20000
MAX_TABLE_CELLS=1000000
